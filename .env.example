# Notion integration token (Internal Integration Secret)
notion_api_key=

# Notion database IDs (same databases your iOS Shortcut writes to — do not change these)
accounts_database_id=
transactions_database_id=

# Linked "Expense Categories" database (read-only lookup for category names —
# does not change anything on the Notion side, just tells our app where to look)
expense_categories_database_id=
